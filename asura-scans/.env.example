# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL — Supabase / Neon / local)
# ─────────────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/asura_scans?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate. On Neon/Supabase this
# is the direct URL; locally it can be the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/asura_scans?schema=public"

# ─────────────────────────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────
# IMAGE STORAGE (Cloudinary or UploadThing) — optional
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ─────────────────────────────────────────────────────────────
# SEARCH (Algolia or MeiliSearch) — optional
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""

MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# ─────────────────────────────────────────────────────────────
# CACHE (Upstash Redis) — optional
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
