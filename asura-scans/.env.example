# Database (PostgreSQL - Supabase/Neon/local)
DATABASE_URL="postgresql://user:password@localhost:5432/asura_scans?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Upstash Redis (optional - caching)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# MeiliSearch (optional - full-text search)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Cloudinary (optional - image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# UploadThing (optional - image uploads)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
