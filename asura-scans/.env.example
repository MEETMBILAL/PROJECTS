# Database (PostgreSQL via Supabase, Neon, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/asura_scans?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Upstash Redis (optional - caching disabled if not set)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# MeiliSearch (optional - falls back to DB search if not set)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Uploadthing (optional - for image uploads)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Cloudinary (optional - alternative image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
