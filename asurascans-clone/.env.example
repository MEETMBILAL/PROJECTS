# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL — Supabase / Neon / local)
# ─────────────────────────────────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/asurascans?schema=public"
# Direct connection used by Prisma migrations (Neon/Supabase poolers need this).
DIRECT_URL="postgresql://user:password@localhost:5432/asurascans?schema=public"

# ─────────────────────────────────────────────────────────────
# NextAuth.js
# ─────────────────────────────────────────────────────────────
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────
# Image storage (choose one — optional; placeholders used otherwise)
# ─────────────────────────────────────────────────────────────
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# uploadthing
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ─────────────────────────────────────────────────────────────
# Search (optional — falls back to DB/in-memory search)
# ─────────────────────────────────────────────────────────────
# MeiliSearch
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""
# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""

# ─────────────────────────────────────────────────────────────
# Redis cache (Upstash — optional; in-memory fallback otherwise)
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
