// Prisma schema for the Asura Scans clone
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// ENUMS
// ───────────────────────────────────────────────────────────
enum ComicStatus {
  ONGOING
  COMPLETED
  HIATUS
}

enum ComicType {
  MANGA
  MANHWA
  MANHUA
}

enum Role {
  USER
  ADMIN
}

// ───────────────────────────────────────────────────────────
// AUTH (NextAuth compatible)
// ───────────────────────────────────────────────────────────
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed (credentials provider)
  role          Role       @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts  Account[]
  sessions  Session[]
  bookmarks Bookmark[]
  ratings   Rating[]
  views     View[]
  comments  Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────────────────────────────────────
// CONTENT
// ───────────────────────────────────────────────────────────
model Comic {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  altTitles   String[]    @default([])
  coverImage  String
  bannerImage String?
  synopsis    String      @db.Text
  status      ComicStatus @default(ONGOING)
  type        ComicType   @default(MANHWA)
  author      String?
  artist      String?
  releaseYear Int?
  totalViews  Int         @default(0)
  weeklyViews Int         @default(0)
  monthlyViews Int        @default(0)
  avgRating   Float       @default(0)
  ratingCount Int         @default(0)
  featured    Boolean     @default(false)
  isNew       Boolean     @default(false)
  isHot       Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  chapters  Chapter[]
  genres    ComicGenre[]
  bookmarks Bookmark[]
  ratings   Rating[]
  views     View[]
  comments  Comment[]

  @@index([status])
  @@index([type])
  @@index([totalViews])
  @@index([updatedAt])
}

model Chapter {
  id          String   @id @default(cuid())
  comicId     String
  number      Float
  title       String?
  views       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  comic    Comic         @relation(fields: [comicId], references: [id], onDelete: Cascade)
  pages    ChapterPage[]
  comments Comment[]

  @@unique([comicId, number])
  @@index([comicId])
}

model ChapterPage {
  id        String  @id @default(cuid())
  chapterId String
  pageNumber Int
  imageUrl  String
  width     Int?
  height    Int?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, pageNumber])
  @@index([chapterId])
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  slug   String       @unique
  comics ComicGenre[]
}

model ComicGenre {
  comicId String
  genreId String

  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([comicId, genreId])
  @@index([genreId])
}

model Bookmark {
  id              String   @id @default(cuid())
  userId          String
  comicId         String
  lastReadChapter Float? // chapter number the user last read
  createdAt       DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId])
  @@index([userId])
}

model Rating {
  id      String @id @default(cuid())
  userId  String
  comicId String
  value   Int // 1 - 10

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId])
  @@index([comicId])
}

model View {
  id        String   @id @default(cuid())
  comicId   String
  userId    String?
  createdAt DateTime @default(now())

  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([comicId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  comicId   String?
  chapterId String?
  content   String   @db.Text
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic   Comic?   @relation(fields: [comicId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([comicId])
  @@index([chapterId])
}
