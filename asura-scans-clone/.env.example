# ---------------------------------------------------------------------------
# Database (PostgreSQL — Supabase / Neon / local docker)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asura?schema=public"

# ---------------------------------------------------------------------------
# NextAuth.js
# ---------------------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Image storage (optional — Cloudinary or UploadThing)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ---------------------------------------------------------------------------
# Redis cache (Upstash) — optional. App falls back to in-memory if unset.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Search (MeiliSearch / Algolia) — optional. App falls back to DB search.
# ---------------------------------------------------------------------------
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
ALGOLIA_ADMIN_KEY=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
