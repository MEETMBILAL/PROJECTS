# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# PostgreSQL (Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/asura_scans?schema=public"

# Google OAuth for NextAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MeiliSearch catalog search
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
MEILISEARCH_COMICS_INDEX=comics

# Upstash Redis hot data cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
