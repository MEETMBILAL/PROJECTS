# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# PostgreSQL (Supabase, Neon, or Prisma Accelerate)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/asura_scans_clone?schema=public

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis hot-data cache (Upstash)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Image storage (choose one for uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Search provider (choose one)
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_ADMIN_API_KEY=your-algolia-admin-key
ALGOLIA_SEARCH_API_KEY=your-algolia-search-key
ALGOLIA_INDEX_NAME=comics
MEILISEARCH_HOST=https://your-meilisearch-host
MEILISEARCH_API_KEY=your-meilisearch-key
MEILISEARCH_INDEX_NAME=comics
