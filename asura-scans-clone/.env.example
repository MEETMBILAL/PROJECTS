# ───────────────────────────────────────────────────────────
# DATABASE (PostgreSQL — Supabase / Neon / local)
# ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asurascans?schema=public"

# ───────────────────────────────────────────────────────────
# NEXTAUTH
# ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ───────────────────────────────────────────────────────────
# GOOGLE OAUTH (https://console.cloud.google.com/apis/credentials)
# ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────────────────────────────────────────────────────────
# IMAGE STORAGE — Cloudinary (optional, app falls back to picsum)
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ───────────────────────────────────────────────────────────
# UPLOADTHING (optional alternative to Cloudinary)
# ───────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=""

# ───────────────────────────────────────────────────────────
# SEARCH — MeiliSearch / Algolia (optional, app falls back to DB search)
# ───────────────────────────────────────────────────────────
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
ALGOLIA_ADMIN_KEY=""

# ───────────────────────────────────────────────────────────
# REDIS CACHE — Upstash (optional, app falls back to in-memory)
# ───────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ───────────────────────────────────────────────────────────
# APP
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
